# Vivado working files and generated caches
.Xil/
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.sim/

# Keep selected existing deliverables in their original run directories.
# Intermediate implementation/synthesis files are regenerated by Vivado.
/project_1/project_1.runs/*
!/project_1/project_1.runs/synth_1/
!/project_1/project_1.runs/impl_1/
/project_1/project_1.runs/synth_1/*
/project_1/project_1.runs/impl_1/*
!/project_1/project_1.runs/synth_1/*.rpt
!/project_1/project_1.runs/impl_1/*.rpt
!/project_1/project_1.runs/impl_1/*.bit
!/project_1/project_1.runs/impl_1/*.bin
!/project_1/project_1.runs/impl_1/*.ltx

# Logs, simulation waveforms, and temporary files
*.jou
*.log
*.wdb
*.vcd
*.str
*.tmp
*.bak
*~
Thumbs.db
Desktop.ini
.DS_Store
